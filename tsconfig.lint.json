{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "/docs-src/*": ["./apps/site/src/*"],
      "/playground-src/*": ["./apps/site/src/playground/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "examples/*/src/**/*.ts",
    "examples/*/src/**/*.tsx",
    "examples/*/app/**/*.ts",
    "examples/*/app/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
  ]
}
