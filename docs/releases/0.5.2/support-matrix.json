      "status": "qualified",
      "evidence": ["tests/framework-consumers/framework-tarballs.mjs", "tests/vnext/browser/react.spec.ts"]
    },
    {
      "id": "vue",
      "version": "3.5.42",
      "status": "qualified",
      "evidence": ["tests/framework-consumers/framework-tarballs.mjs"]
    },
    {
