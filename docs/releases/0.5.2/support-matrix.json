  "providers": [
    {
      "id": "none",
      "status": "qualified",
      "scope": "All core, runtime, web, React, SSR, local-data, remote-data, and reference-journey paths operate without a model."
    },
    {
      "id": "local-protocol-fixture",
      "status": "protocol-only",
      "scope": "Synthetic localhost conformance for the provider-neutral protocol.",
      "evidence": ["tests/vnext/model-profile.test.ts", "tests/protocol-model"]
    },
    {
      "id": "deepseek-flash-live-j1-j3",
      "status": "qualified-bounded",
      "scope": "DeepSeek deepseek-flash passed all 12 synthetic J1–J3 browser/provider/renderer cases on a tree-equivalent PR head. This qualifies only that model and corpus, not other models, providers, production workloads, or human use.",
      "evidence": [
        "tests/agent-evaluation/j1-j3-corpus.json",
        "tests/agent-evaluation/live-journey-runner.mjs",
        "docs/releases/0.5.0/evidence/deepseek-flash-j1-j3-21afcca.json"
      ]
    },
    {
      "id": "openai-compatible-live",
      "status": "unverified",
      "reason": "No general OpenAI-compatible provider or model profile is qualified by the bounded DeepSeek result."
    },
    {
      "id": "other-hosted-providers",
      "status": "unverified",
      "reason": "Provider-specific quality and latency are not inferred from protocol compatibility."
    }
  ],
  "workloads": [
    {
      "id": "playground-j1-j3",
      "status": "qualified-bounded",
      "scope": "The People Jakarta, Daily attendance, and Analytical workspace playground journeys exercise approved synthetic data through the real runtime and renderer without requiring a model.",
