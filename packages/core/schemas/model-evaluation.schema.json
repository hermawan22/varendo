{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "untested",
          "maxLength": 16384
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "additionalProperties": false,
      "maxProperties": 256,
      "propertyNames": {
        "maxLength": 160,
        "not": {
          "const": "__proto__"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "evaluated",
          "maxLength": 16384
        },
        "modelSnapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "recipeDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "corpusDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "trials": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evidenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "permittedGrantsChanged": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "state",
        "modelSnapshot",
        "recipeDigest",
        "corpusDigest",
        "trials",
        "evidenceId",
        "scope",
        "permittedGrantsChanged"
      ],
      "additionalProperties": false,
      "maxProperties": 256,
      "propertyNames": {
        "maxLength": 160,
        "not": {
          "const": "__proto__"
        }
      }
    }
  ],
  "$id": "https://hermawan22.github.io/varendo/schemas/1/model-evaluation.schema.json",
  "$comment": "Shape contract only. Apply documented byte/depth/node/JSON-object ingress limits before recursive validation; binding and authority are separate."
}
