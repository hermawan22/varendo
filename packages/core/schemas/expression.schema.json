{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "literal",
          "maxLength": 16384
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "maxLength": 16384
            },
            {
              "type": "object",
              "properties": {
                "decimal": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                }
              },
              "required": [
                "decimal"
              ],
              "additionalProperties": false,
              "maxProperties": 256,
              "propertyNames": {
                "maxLength": 160,
                "not": {
                  "const": "__proto__"
                }
              }
            }
          ]
        },
        "type": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "text",
                "boolean",
                "integer",
                "float",
                "decimal",
                "date",
                "instant"
              ],
              "maxLength": 16384
            },
            "nullable": {
              "type": "boolean"
            },
            "unit": {
              "type": "object",
              "properties": {
                "dimension": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "currency": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
                }
              },
              "required": [
                "dimension",
                "symbol"
              ],
              "additionalProperties": false,
              "maxProperties": 256,
              "propertyNames": {
                "maxLength": 160,
                "not": {
                  "const": "__proto__"
                }
              }
            },
            "grain": {
              "maxItems": 10000,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
              }
            },
            "temporal": {
              "type": "object",
              "properties": {
                "calendar": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
                },
                "grain": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
                }
              },
              "required": [
                "calendar"
              ],
              "additionalProperties": false,
              "maxProperties": 256,
              "propertyNames": {
                "maxLength": 160,
                "not": {
                  "const": "__proto__"
                }
              }
            }
          },
          "required": [
            "value",
            "nullable"
          ],
          "additionalProperties": false,
          "maxProperties": 256,
          "propertyNames": {
            "maxLength": 160,
            "not": {
              "const": "__proto__"
            }
          }
        }
      },
      "required": [
        "kind",
        "value",
        "type"
      ],
      "additionalProperties": false,
      "maxProperties": 256,
      "propertyNames": {
        "maxLength": 160,
        "not": {
          "const": "__proto__"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "field",
          "maxLength": 16384
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "entity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false,
      "maxProperties": 256,
      "propertyNames": {
        "maxLength": 160,
        "not": {
          "const": "__proto__"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "definition",
          "maxLength": 16384
        },
        "ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false,
          "maxProperties": 256,
          "propertyNames": {
            "maxLength": 160,
            "not": {
              "const": "__proto__"
            }
          }
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false,
      "maxProperties": 256,
      "propertyNames": {
        "maxLength": 160,
        "not": {
          "const": "__proto__"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "call",
          "maxLength": 16384
        },
        "function": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false,
          "maxProperties": 256,
          "propertyNames": {
            "maxLength": 160,
            "not": {
              "const": "__proto__"
            }
          }
        },
        "arguments": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "kind",
        "function",
        "arguments"
      ],
      "additionalProperties": false,
      "maxProperties": 256,
      "propertyNames": {
        "maxLength": 160,
        "not": {
          "const": "__proto__"
        }
      }
    }
  ],
  "$id": "https://hermawan22.github.io/varendo/schemas/1/expression.schema.json",
  "$comment": "Shape contract only. Apply documented byte/depth/node/JSON-object ingress limits before recursive validation; binding and authority are separate."
}
