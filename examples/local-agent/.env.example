# Optional local agent model connection. Copy this file to .env.local.
# Never commit .env.local or a real provider key.
AELIQO_MODEL_BASE_URL=https://your-provider.example/v1/
AELIQO_MODEL=your-tool-capable-model
AELIQO_MODEL_PROTOCOL=openai-compatible-chat
AELIQO_MODEL_AUTH_SCHEME=bearer
AELIQO_MODEL_API_KEY=replace-in-local-env-only
AELIQO_MODEL_CAPABILITIES=tool-calls,usage,request-cancellation

# For a local server without authentication, set AUTH_SCHEME=none and omit API_KEY.
# For header authentication, set AUTH_SCHEME=header and provide AELIQO_MODEL_AUTH_HEADER.
# AELIQO_MODEL_AUTH_HEADER=x-api-key
# To use a compatible Responses endpoint instead, set PROTOCOL=openai-compatible-responses.
# That profile requires HTTPS bearer authentication and has no request-retry capability.

# Leave unset for HTTPS providers. Set to 1 only for a loopback HTTP test server.
# AELIQO_ALLOW_INSECURE_MODEL_HTTP=1
